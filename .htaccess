# Cache-regler til webserveren (Apache, fx Simply.com).
# Filen kommer med i dist/ og dermed i release-zip'en.
#
# index.html skal altid tjekkes hos serveren (no-cache), så en ny version
# slår igennem med det samme i stedet for at browseren viser den gamle.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
</IfModule>
